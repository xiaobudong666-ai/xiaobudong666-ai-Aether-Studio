# Aether Studio Environment Variables Template
# Copy this file to '.env' inside respective folders as needed

# 1. API Configurations
DATABASE_URL=sqlite:////data/aether.db
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AETHER_BOOTSTRAP_ADMIN_EMAIL=admin@aether.local
# Required on the first start. Use a unique password with at least 12 characters.
AETHER_BOOTSTRAP_ADMIN_PASSWORD=
AETHER_BOOTSTRAP_TENANT_NAME=Aether Studio
# Required by both API and Worker; generate with: openssl rand -hex 32
AETHER_WORKER_TOKEN=
AETHER_COOKIE_SECURE=true
AETHER_ENFORCE_CSRF=true
AETHER_SESSION_HOURS=12
AETHER_MAX_UPLOAD_BYTES=2147483648
AETHER_PROJECT_QUOTA=50
AETHER_STORAGE_QUOTA_BYTES=53687091200
AETHER_CONCURRENT_RENDER_QUOTA=2
AETHER_MONTHLY_RENDER_SECONDS_QUOTA=36000

# Governed generation Provider. The only safe committed default is disabled.
# Real activation, configuration identifiers and policy hashes require separate approval.
AETHER_GENERATION_PROVIDER_MODE=disabled
AETHER_GENERATION_TENANT_ID=
AETHER_GENERATION_CONFIG_VERSION_ID=
AETHER_GENERATION_POLICY_HASH=
AETHER_GENERATION_MAX_ARTIFACT_BYTES=2147483648
# Non-secret canary readiness markers. Base/default values are fail-closed.
AETHER_GENERATION_CREDENTIAL_STATE=ABSENT
AETHER_GENERATION_NETWORK_ISOLATION=NOT_ENFORCED
AETHER_GENERATION_CANARY_PROFILE=disabled

# 2. Worker Configurations
BACKEND_URL=http://api:8000
WORKER_PORT=8001
AETHER_RENDER_TIMEOUT_SECONDS=3600

# 3. Web Configurations (Vite environment variables)
# Optional for non-proxied deployments. The default is same-origin /api.
VITE_API_BASE_URL=/api

# 4. MoneyPrinterTurbo Sidecar Adapter Configurations
# Read only by the Worker, and only when AETHER_GENERATION_PROVIDER_MODE=moneyprinter.
MONEYPRINTER_API_URL=http://moneyprinter-sidecar:8080
MONEYPRINTER_TIMEOUT=10.0
MONEYPRINTER_MAX_RETRIES=3
MONEYPRINTER_RETRY_BACKOFF=2.0
MONEYPRINTER_DEGRADE_ON_FAILURE=false
# Real target-local config is intentionally not templated here. A future separately approved
# private canary must provide MONEYPRINTER_CONFIG_FILE only through the canary override.
