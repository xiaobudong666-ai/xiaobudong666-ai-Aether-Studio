# Aether Studio Environment Variables Template
# Copy this file to '.env' inside respective folders as needed

# 1. API Configurations
DATABASE_URL=sqlite:////data/aether.db
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 2. Worker Configurations
BACKEND_URL=http://api:8000
WORKER_PORT=8001

# 3. Web Configurations (Vite environment variables)
# Optional for non-proxied deployments. The default is same-origin /api.
VITE_API_BASE_URL=/api

# 4. MoneyPrinterTurbo Sidecar Adapter Configurations
MONEYPRINTER_API_URL=http://localhost:8080
MONEYPRINTER_TIMEOUT=10.0
MONEYPRINTER_MAX_RETRIES=3
MONEYPRINTER_RETRY_BACKOFF=2.0
MONEYPRINTER_DEGRADE_ON_FAILURE=false
