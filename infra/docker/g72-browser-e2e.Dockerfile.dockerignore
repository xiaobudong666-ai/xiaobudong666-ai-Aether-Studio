# Dockerfile-specific ignore for the disposable G72 Playwright runner.
# This file takes precedence over the repository-root .dockerignore.
# Keep the browser image build context free of local credentials and bulky artifacts.

.git
**/.git
.github
**/.github
.venv
**/.venv
venv
**/venv
env
**/env
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store
dist
**/dist
build
**/build
__pycache__
**/__pycache__
.pytest_cache
**/.pytest_cache
playwright-report
test-results
test-results-g72
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

.env
.env.*
**/.env
**/.env.*
.envrc
**/.envrc

# Credential/config stores: never copy developer or CI auth state into the runner.
.npmrc
**/.npmrc
.netrc
**/.netrc
.pypirc
**/.pypirc
.ssh/
**/.ssh/**
.aws/
**/.aws/**
.azure/
**/.azure/**
.config/gcloud/
**/.config/gcloud/**
.docker/config.json
**/.docker/config.json
.kube/
**/.kube/**
.vault-token
**/.vault-token
**/*credentials*.json
**/*service-account*.json
**/*service_account*.json
**/*token*.json

# Private keys, certificates, signing profiles, and keystores.
secrets/
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.p8
**/*.crt
**/*.cer
**/*.der
**/*.jks
**/*.keystore
**/*.mobileprovision
**/id_rsa*
**/id_ed25519*

# Provider canary inputs and evidence are never part of browser test images.
*provider-canary*.toml
*provider-canary*.env
*provider-canary*.json
*provider-canary*.evidence
