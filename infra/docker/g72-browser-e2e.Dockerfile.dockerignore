# Dockerfile-specific ignore for the disposable G72 Playwright runner.
# This file takes precedence over the repository-root .dockerignore.
# Keep the browser image build context free of local credentials and bulky artifacts.

.git
**/.git
.github
**/.github
.venv
**/.venv
venv
**/venv
env
**/env
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store
dist
**/dist
build
**/build
__pycache__
**/__pycache__
.pytest_cache
**/.pytest_cache
playwright-report
test-results
test-results-g72
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

.env
.env.*
**/.env
**/.env.*

secrets/
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
*provider-canary*.toml
*provider-canary*.env
*provider-canary*.json
*provider-canary*.evidence
