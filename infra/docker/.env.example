# Stable Compose namespace. Changing it creates a different set of named volumes.
COMPOSE_PROJECT_NAME=aether-production

# Public workbench listener. Bind to 127.0.0.1 when a host reverse proxy owns TLS.
AETHER_HTTP_BIND=127.0.0.1
AETHER_HTTP_PORT=8088

# Loopback-only operator health endpoints.
AETHER_API_PORT=8000
AETHER_WORKER_PORT=8001

# Optional separate-window fallback editor. Leave empty to hide the link.
VITE_OPENREEL_URL=

# Maximum accepted Sidecar upload size in bytes (default: 2 GiB).
VIDEO_USE_MAX_UPLOAD_BYTES=2147483648

# Optional. Without this key, transcription is truthfully reported unavailable.
ELEVENLABS_API_KEY=
