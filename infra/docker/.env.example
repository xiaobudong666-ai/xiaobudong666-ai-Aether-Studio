# Stable Compose namespace. Changing it creates a different set of named volumes.
COMPOSE_PROJECT_NAME=aether-production

# Public workbench listener. Bind to 127.0.0.1 when a host reverse proxy owns TLS.
AETHER_HTTP_BIND=127.0.0.1
AETHER_HTTP_PORT=8088

# Loopback-only operator health endpoints.
AETHER_API_PORT=8000
AETHER_WORKER_PORT=8001

# First-start owner identity. The password must be 12+ characters and unique.
AETHER_BOOTSTRAP_ADMIN_EMAIL=admin@aether.local
AETHER_BOOTSTRAP_ADMIN_PASSWORD=
AETHER_BOOTSTRAP_TENANT_NAME=Aether Studio

# Shared only by API and Worker. Generate with: openssl rand -hex 32
AETHER_WORKER_TOKEN=

# Keep true behind the required HTTPS entrypoint.
AETHER_COOKIE_SECURE=true
AETHER_ENFORCE_CSRF=true

# Initial tenant quotas (persisted in SQLite on first bootstrap).
AETHER_PROJECT_QUOTA=50
AETHER_STORAGE_QUOTA_BYTES=53687091200
AETHER_CONCURRENT_RENDER_QUOTA=2
AETHER_MONTHLY_RENDER_SECONDS_QUOTA=36000

# Optional separate-window fallback editor. Leave empty to hide the link.
VITE_OPENREEL_URL=

# Maximum accepted Sidecar upload size in bytes (default: 2 GiB).
VIDEO_USE_MAX_UPLOAD_BYTES=2147483648
# Public proxy/API ceiling. Tenant storage quotas remain lower and are enforced separately.
AETHER_MAX_UPLOAD_BYTES=2147483648

# Optional. Without this key, transcription is truthfully reported unavailable.
ELEVENLABS_API_KEY=
