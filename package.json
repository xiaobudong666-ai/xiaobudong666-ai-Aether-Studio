{
  "name": "aether-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Aether Studio - AI anime short video editor foundation",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" build",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" test",
    "lint": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" lint"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0"
  }
}
